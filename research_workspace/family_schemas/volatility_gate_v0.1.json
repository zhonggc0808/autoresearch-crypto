{
  "type": "object",
  "description": "Volatility gate filter parameters",
  "required": ["family", "metric", "threshold", "action", "lookback"],
  "properties": {
    "family": {
      "const": "volatility_gate",
      "description": "Filter family identifier"
    },
    "metric": {
      "type": "string",
      "enum": ["atr_close_ratio", "atr_pct", "bb_width", "keltner_width"],
      "description": "Volatility metric to measure"
    },
    "threshold": {
      "type": "number",
      "minimum": 0.0001,
      "maximum": 0.10,
      "description": "ATR/close ratio threshold. Calibrated on ETH 5m: p90=0.0039, p95=0.0047, p99=0.0069. Values >0.01 are no-op. Typical: 0.003-0.007"
    },
    "action": {
      "type": "string",
      "enum": [
        "block_entries_when_high_vol",
        "block_entries_when_low_vol",
        "reduce_position_size",
        "block_short_entries_when_high_vol",
        "block_long_entries_when_high_vol"
      ],
      "description": "What the gate does. Directional variants only block one side."
    },
    "lookback": {
      "type": "integer",
      "minimum": 5,
      "maximum": 500,
      "description": "Lookback period (bars) for computing the volatility metric"
    }
  },
  "additionalProperties": false
}
