{
  "type": "object",
  "description": "Volatility gate filter parameters",
  "required": ["family", "metric", "threshold", "action", "lookback"],
  "properties": {
    "family": {
      "const": "volatility_gate",
      "description": "Filter family identifier"
    },
    "metric": {
      "type": "string",
      "enum": ["atr_close_ratio", "atr_pct", "bb_width", "keltner_width"],
      "description": "Volatility metric to measure"
    },
    "threshold": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 0.50,
      "description": "Threshold value for the metric to trigger the gate"
    },
    "action": {
      "type": "string",
      "enum": ["block_entries_when_high_vol", "block_entries_when_low_vol", "reduce_position_size"],
      "description": "What the gate does when the threshold is breached"
    },
    "lookback": {
      "type": "integer",
      "minimum": 5,
      "maximum": 500,
      "description": "Lookback period (bars) for computing the volatility metric"
    }
  },
  "additionalProperties": false
}
