{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChannelBreakout v0.2",
  "description": "Regime-permission channel breakout (Donchian). Regime-filtered long/short with permission arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_type", "regime_change_policy", "regime_filter", "bull", "bear", "neutral"],
  "properties": {
    "strategy_type": { "type": "string", "enum": ["regime_permission_channel_breakout"] },
    "regime_change_policy": { "type": "string", "enum": ["permission_based"] },
    "regime_filter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fast_days": { "type": "integer", "minimum": 5, "maximum": 200 },
        "slow_days": { "type": "integer", "minimum": 10, "maximum": 500 }
      }
    },
    "filter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["adx_gate"] },
        "adx_threshold": { "type": "integer", "minimum": 10, "maximum": 40 },
        "apply_to": { "type": "array", "items": { "type": "string", "enum": ["bull", "bear", "neutral"] }, "uniqueItems": true }
      }
    },
    "bull": { "$ref": "#/definitions/regime_config" },
    "bear": { "$ref": "#/definitions/regime_config" },
    "neutral": { "$ref": "#/definitions/regime_config" }
  },
  "definitions": {
    "strategy_params": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_lookback", "min_hold_bars"],
      "properties": {
        "entry_lookback": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "min_hold_bars": { "type": "integer", "minimum": 12, "maximum": 1440 },
        "enable_long": { "type": "boolean" },
        "enable_short": { "type": "boolean" }
      }
    },
    "permission_config": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_long", "allow_short"],
      "properties": {
        "allow_long": { "type": "boolean" },
        "allow_short": { "type": "boolean" },
        "close_below_ema_disables_long": { "type": "boolean" },
        "directional_only": { "type": "boolean" },
        "ema_fast": { "type": "integer", "minimum": 5, "maximum": 200 },
        "ema_slope_days": { "type": "integer", "minimum": 2, "maximum": 30 },
        "consecutive_below_ema_days": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "regime_config": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy_params", "permission"],
      "properties": {
        "candidate": { "type": "string" },
        "description": { "type": "string" },
        "strategy_params": { "$ref": "#/definitions/strategy_params" },
        "permission": { "$ref": "#/definitions/permission_config" }
      }
    }
  }
}
