# =============================================================================
# Nado DEX Configuration
# =============================================================================
# Get your private key from your Nado wallet.
# WARNING: Never commit your real private key to git.
NADO_PRIVATE_KEY=0x_your_private_key_here

# =============================================================================
# OKX Exchange Configuration (optional)
# =============================================================================
# Required only if using OKX live trading (live_okx_quant.py).
# Create API keys at: https://www.okx.com/account/my-api
OKX_API_KEY=your_api_key
OKX_API_SECRET=your_api_secret
OKX_PASSPHRASE=your_passphrase

# =============================================================================
# Binance Exchange Configuration (optional)
# =============================================================================
# Required only if using Binance live trading (live_binance_quant.py).
# Create API keys at: https://www.binance.com/en/my/settings/api-management
# The key must have Futures trading enabled.
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# =============================================================================
# Bitget Exchange Configuration (optional)
# =============================================================================
# Required only if using Bitget live trading (live_bitget_quant.py).
# Create API keys at: https://www.bitget.com/account/api
# The key must have Futures trading enabled.
BITGET_API_KEY=your_api_key
BITGET_API_SECRET=your_api_secret
BITGET_PASSPHRASE=your_passphrase

# =============================================================================
# Email Notification (optional)
# =============================================================================
# Transaction notifications are sent for fills, flips, forced closes, and errors.
# Uses SMTP with SSL on port 465.
# TRADE_NOTIFY_EMAIL_TO=your_email@example.com
# TRADE_NOTIFY_SMTP_USER=your_email@example.com
# TRADE_NOTIFY_SMTP_PASSWORD=your_app_password
# TRADE_NOTIFY_SMTP_HOST=smtp.example.com
# TRADE_NOTIFY_SMTP_PORT=465

# =============================================================================
# Network Proxy (optional)
# =============================================================================
# If you are in a region that requires a proxy to access exchange APIs,
# uncomment and set the following:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
